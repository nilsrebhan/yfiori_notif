{
	"_version": "1.5.0",
	"sap.app": {
		"_version": "1.3.0",
		"id": "com.pag.flp.notifications",
		"type": "component",
		"applicationVersion": {
			"version": ""
		},
		"title": "{{plugin_title}}",
		"dataSources": {
			"YFIORI_NOTIF_SRV": {
				"uri": "/sap/opu/odata/sap/YFIORI_NOTIF_SRV/",
				"type": "OData",
				"settings": {
					"odataVersion": "2.0",
					"localUri": "model/metadata.xml"
				}
			}
		}
	},
	"sap.ui": {
		"_version": "1.3.0",
		"technology": "UI5",
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		},
		"supportedThemes": []
	},
	"sap.ui5": {
		"_version": "1.2.0",
		"contentDensities": {
			"compact": true,
			"cozy": false
		},
		"dependencies": {
			"minUI5Version": "1.38.1",
			"libs": {
				"sap.ui.core": {
					"minVersion": "1.38.1"
				},
				"sap.m": {
					"minVersion": "1.38.1"
				}
			}
		},
		"resources": {
			"css": [{
				"uri": "css/styles.css"
			}]
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "com.pag.flp.notifications.i18n.i18n"
				}
			},
			"": {
				"type": "sap.ui.model.odata.v2.ODataModel",
				"settings": {
					"defaultOperationMode": "Server",
					"defaultBindingMode": "TwoWay",
					"defaultCountMode": "Inline",
					"useBatch": true,
					"defaultUpdateMethod": "Put"
				},
				"dataSource": "YFIORI_NOTIF_SRV"
			},
			"Customizing": {
				"type": "sap.ui.model.json.JSONModel",
				"settings": {}
			},
			"Employee": {
				"type": "sap.ui.model.json.JSONModel",
				"settings": {}
			},
			"Personalization": {
				"type": "sap.ui.model.json.JSONModel",
				"settings": {}
			},
			"Runtime": {
				"type": "sap.ui.model.json.JSONModel",
				"settings": {}
			}
		},
		"componentName": "com.pag.flp.notifications"
	},
	"sap.flp": {
		"type": "plugin",
		"config": {},
		"_version": "1.1.0"
	}
}